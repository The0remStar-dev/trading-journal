generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trade {
  id              String        @id @default(uuid())
  userId          String
  accountType     AccountType   @default(LIVE)
  symbol          String
  direction       Direction
  entryDate       DateTime
  exitDate        DateTime?
  entryPrice      Float
  exitPrice       Float?
  positionSize    Float
  fees            Float         @default(0)
  pnl             Float         @default(0)
  pnlPercentage   Float         @default(0)
  riskRewardRatio Float?
  status          TradeStatus   @default(OPEN)
  tags            String        @default("[]")
  notes           String?
  beforeImageUrl  String?
  afterImageUrl   String?
  emotion         TradeEmotion?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([entryDate])
  @@index([symbol])
  @@index([status])
  @@index([accountType])
}

enum AccountType {
  LIVE
  BACKTEST
  EVALUATION
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  WIN
  LOSS
  BREAKEVEN
  OPEN
}

enum ExperienceLevel {
  BEGINNER      // < 1 an
  INTERMEDIATE  // 1-3 ans
  ADVANCED      // 3-5 ans
  EXPERT        // > 5 ans
}

enum Language {
  FR
  EN
  ES
}

enum TradeEmotion {
  FOMO
  REVENGE
  IMPATIENT
  FEARFUL
  GREEDY
  CONFIDENT
  PATIENT
  DISCIPLINED
  STRESSED
  NEUTRAL
}

model Profile {
  // L'id correspond directement à l'UUID de l'utilisateur Supabase (auth.users.id).
  // Pas d'auto-génération : il est fourni explicitement à la création.
  id String @id

  username   String  @unique
  fullName   String?
  avatarUrl  String?
  bio        String?

  experienceLevel ExperienceLevel @default(BEGINNER)

  // Capital initial de référence, utilisé uniquement pour normaliser les
  // performances en "R" côté plateforme. Ce champ ne doit JAMAIS être exposé
  // publiquement dans les API de social trading (profils publics, feed, etc.).
  initialCapital Float?

  // Pourcentage du capital initial risqué par trade, utilisé comme base de
  // calcul du "1R" pour toute la plateforme (ex: 1% de 10 000$ = 100$ = 1R).
  riskPerTradePercent Float @default(1)

  language Language @default(FR)

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model Post {
  id String @id @default(uuid())

  userId  String
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  emotion        TradeEmotion @default(NEUTRAL)
  mistakeSummary String
  lessonLearned  String

  beforeImageUrl String?
  afterImageUrl  String?

  linkedTradeId String?
  symbol        String?
  direction     Direction?
  entryPrice    Float?
  exitPrice     Float?
  rMultiple     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}