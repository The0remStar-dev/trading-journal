generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trade {
  id              String      @id @default(uuid())
  userId          String
  accountType     AccountType @default(LIVE)
  symbol          String
  direction       Direction
  entryDate       DateTime
  exitDate        DateTime?
  entryPrice      Float
  exitPrice       Float?
  positionSize    Float
  fees            Float       @default(0)
  pnl             Float       @default(0)
  pnlPercentage   Float       @default(0)
  riskRewardRatio Float?
  status          TradeStatus @default(OPEN)
  tags            String      @default("[]")
  notes           String?
  beforeImageUrl  String?
  afterImageUrl   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([entryDate])
  @@index([symbol])
  @@index([status])
  @@index([accountType])
}

enum AccountType {
  LIVE
  BACKTEST
  EVALUATION
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  WIN
  LOSS
  BREAKEVEN
  OPEN
}